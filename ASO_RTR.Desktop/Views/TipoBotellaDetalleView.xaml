<UserControl x:Class="ASO_RTR.Desktop.Views.TipoBotellaDetalleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_RTR.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="440">

  <StackPanel>
    <TextBlock Text="{Binding PresentacionTexto}" FontSize="{StaticResource FsCaption}"
               Foreground="{DynamicResource TextSecondaryBrush}" />

    <Grid Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="Niveles" FontSize="{StaticResource FsCaption}"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Text="{Binding CantidadNiveles}" Style="{StaticResource FormValorCalculadoStyle}" />
      </StackPanel>

      <StackPanel Grid.Column="1">
        <TextBlock Text="Botellas/nivel" FontSize="{StaticResource FsCaption}"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Text="{Binding BotellasPorNivel}" Style="{StaticResource FormValorCalculadoStyle}" />
      </StackPanel>

      <StackPanel Grid.Column="2">
        <TextBlock Text="Total en paleta" FontSize="{StaticResource FsCaption}"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Text="{Binding BotellasPorPaleta}" Style="{StaticResource FormValorCalculadoStyle}" />
      </StackPanel>
    </Grid>

    <controls:FormField Etiqueta="Desglose por nivel" Margin="0,20,0,0">
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="{StaticResource RadSm}" Padding="8" MaxHeight="240">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding DetalleNiveles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding NumeroTexto}"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding DetalleTexto}"
                             FontSize="{StaticResource FsCaption}"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </controls:FormField>

    <controls:FormField Etiqueta="Patrón · niveles impares (1, 3, 5…)" Margin="0,20,0,0"
                        Visibility="{Binding EsCaja, Converter={StaticResource BoolToVis}}">
      <ItemsControl ItemsSource="{Binding PatronImpar}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ItemsControl ItemsSource="{Binding}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CeldaOrientacionStyle}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </controls:FormField>

    <controls:FormField Etiqueta="Patrón · niveles pares (2, 4, 6…)" Margin="0,20,0,0"
                        Visibility="{Binding MuestraPatronPar, Converter={StaticResource BoolToVis}}">
      <ItemsControl ItemsSource="{Binding PatronPar}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ItemsControl ItemsSource="{Binding}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CeldaOrientacionStyle}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </controls:FormField>

    <controls:FormField Etiqueta="Panal de botellas por nivel" Margin="0,20,0,0"
                        Visibility="{Binding MuestraPanal, Converter={StaticResource BoolToVis}}">
      <Viewbox StretchDirection="DownOnly" MaxWidth="480" MaxHeight="260" HorizontalAlignment="Left">
        <Canvas Width="{Binding Panal.Ancho}" Height="{Binding Panal.Alto}">
          <ItemsControl ItemsSource="{Binding Panal.Circulos}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <!-- Canvas.Left/Top van en el CONTENEDOR del ítem, no en un elemento dentro del
                 DataTemplate: ver el mismo comentario en TipoBotellaEditorView.xaml. -->
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                <Setter Property="Canvas.Top" Value="{Binding Top}" />
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Ellipse Style="{StaticResource PanalCirculoStyle}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Canvas>
      </Viewbox>
    </controls:FormField>
  </StackPanel>
</UserControl>
