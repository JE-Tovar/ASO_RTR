<UserControl x:Class="ASO_RTR.Desktop.Views.TipoBotellaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_RTR.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="420">

  <StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Marca">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding Marca, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Por ejemplo: Cacique" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Nombre">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <controls:FormField Etiqueta="Medida (presentación)">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               Text="{Binding Medida, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Por ejemplo: 0.95 L, 1.75 L, 750 ml" />
    </controls:FormField>

    <controls:FormField Etiqueta="Presentación">
      <ComboBox Style="{StaticResource FormComboBoxStyle}"
                ItemsSource="{Binding Presentaciones}"
                DisplayMemberPath="Texto"
                SelectedValuePath="Valor"
                SelectedValue="{Binding PresentacionSeleccionada}" />
    </controls:FormField>

    <controls:FormField Etiqueta="Botellas por caja"
                        Visibility="{Binding EsCaja, Converter={StaticResource BoolToVis}}">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               Text="{Binding BotellasPorCaja, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="{Binding EtiquetaUnidadesPorNivel}">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding UnidadesPorNivel, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Niveles de la paleta">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding Niveles, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <CheckBox Content="Activo" Margin="0,16,0,0" Cursor="Hand"
              Foreground="{DynamicResource TextPrimaryBrush}"
              IsChecked="{Binding Activo}" />

    <TextBlock Text="Un tipo de botella inactivo se conserva para el histórico, pero no se ofrece al registrar procesos nuevos."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
