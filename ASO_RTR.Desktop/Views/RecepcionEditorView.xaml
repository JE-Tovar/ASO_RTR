<UserControl x:Class="ASO_RTR.Desktop.Views.RecepcionEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_RTR.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="900">

  <UserControl.Resources>
    <!-- Las columnas del DataGrid no heredan DataContext; ver Controls/PuenteDeDatos.cs -->
    <controls:PuenteDeDatos x:Key="Puente" Datos="{Binding}" />
  </UserControl.Resources>

  <StackPanel>

    <TextBlock Text="El número de la recepción se asigna al registrarla."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Fecha">
          <DatePicker Style="{StaticResource FormDatePickerStyle}"
                      SelectedDate="{Binding Fecha}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Orden de entrega">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding NumeroOrdenEntrega, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="El número del papel que trae el gandolero" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="4">
        <controls:FormField Etiqueta="Placa">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding Placa, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <controls:FormField Etiqueta="Gandolero">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               Text="{Binding Gandolero, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Nombre del conductor" />
    </controls:FormField>

    <!-- Tipos de botella que llegan -->
    <TextBlock Text="Tipos de botella que llegan" Style="{StaticResource CardTitleStyle}" Margin="0,20,0,8" />

    <Border Style="{StaticResource SectionCardStyle}" Padding="0">
      <DataGrid Style="{StaticResource DataGridStyle}"
                ItemsSource="{Binding Lineas}"
                IsReadOnly="True"
                MaxHeight="260"
                HeadersVisibility="Column"
                CanUserSortColumns="False">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Tipo de botella" Width="38*" MinWidth="220">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox Style="{StaticResource LineaComboBoxStyle}"
                          ItemsSource="{Binding TiposBotella}"
                          DisplayMemberPath="Etiqueta"
                          SelectedItem="{Binding TipoBotellaSeleccionado, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="Paletas" Width="16*" MinWidth="100">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox Style="{StaticResource LineaTextBoxStyle}" TextAlignment="Right"
                         Text="{Binding CantidadPaletas, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <controls:ColumnaNumero Header="Botellas" Binding="{Binding TotalBotellasTexto}" Width="16*" MinWidth="100" />

          <DataGridTemplateColumn Width="56">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="{x:Static controls:Iconos.Limpiar}"
                        Style="{StaticResource LineaBotonQuitarStyle}"
                        ToolTip="Quitar esta línea"
                        Command="{Binding Datos.QuitarLineaCommand, Source={StaticResource Puente}}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0" Content="Agregar línea" Margin="0"
              Style="{StaticResource SecondaryButtonStyle}"
              Command="{Binding AgregarLineaCommand}" />

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Paletas" VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Text="{Binding TotalPaletas}" Style="{StaticResource FormValorCalculadoStyle}" />
      </StackPanel>
    </Grid>

    <controls:FormField Etiqueta="Observaciones">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
               VerticalContentAlignment="Top"
               Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>
  </StackPanel>
</UserControl>
