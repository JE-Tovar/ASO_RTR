<UserControl x:Class="ASO_RTR.Desktop.Views.DespachoEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_RTR.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="900">

  <UserControl.Resources>
    <!-- Las columnas del DataGrid no heredan DataContext; ver Controls/PuenteDeDatos.cs -->
    <controls:PuenteDeDatos x:Key="Puente" Datos="{Binding}" />
  </UserControl.Resources>

  <StackPanel>

    <TextBlock Text="El número del despacho se asigna al emitirlo. El destino siempre es Dusa."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Fecha">
          <DatePicker Style="{StaticResource FormDatePickerStyle}"
                      SelectedDate="{Binding Fecha}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Autoriza"
                            Ayuda="Queda a nombre de quien tiene la sesión abierta.">
          <TextBox Style="{StaticResource FormTextBoxStyle}" IsReadOnly="True" Focusable="False"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding AutorizadoPorNombre, Mode=OneWay}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <!-- Tipos de botella que salen -->
    <TextBlock Text="Tipos de botella que salen" Style="{StaticResource CardTitleStyle}" Margin="0,20,0,8" />

    <Border Style="{StaticResource SectionCardStyle}" Padding="0">
      <DataGrid Style="{StaticResource DataGridStyle}"
                ItemsSource="{Binding Lineas}"
                IsReadOnly="True"
                MaxHeight="260"
                HeadersVisibility="Column"
                CanUserSortColumns="False">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Tipo de botella" Width="36*" MinWidth="220">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox Style="{StaticResource LineaComboBoxStyle}"
                          ItemsSource="{Binding TiposBotella}"
                          DisplayMemberPath="Etiqueta"
                          SelectedItem="{Binding TipoBotellaSeleccionado, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <controls:ColumnaNumero Header="Disponible" Binding="{Binding DisponibleTexto}" Width="16*" MinWidth="96" />

          <DataGridTemplateColumn Header="Paletas" Width="16*" MinWidth="100">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox TextAlignment="Right"
                         Text="{Binding CantidadPaletas, UpdateSourceTrigger=PropertyChanged}">
                  <TextBox.Style>
                    <!-- Aviso inmediato de que se pide más de lo que hay en custodia. Quien
                         decide de verdad es DespachosService.Validar al emitir el despacho. -->
                    <Style TargetType="TextBox" BasedOn="{StaticResource LineaTextBoxStyle}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SePasa}" Value="True">
                          <Setter Property="BorderBrush" Value="{DynamicResource DangerTextBrush}" />
                          <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                          <Setter Property="ToolTip" Value="No hay tantas paletas en custodia de este tipo." />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBox.Style>
                </TextBox>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Width="56">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="{x:Static controls:Iconos.Limpiar}"
                        Style="{StaticResource LineaBotonQuitarStyle}"
                        ToolTip="Quitar esta línea"
                        Command="{Binding Datos.QuitarLineaCommand, Source={StaticResource Puente}}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0" Content="Agregar línea" Margin="0"
              Style="{StaticResource SecondaryButtonStyle}"
              Command="{Binding AgregarLineaCommand}" />

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Paletas" VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Text="{Binding TotalPaletas}" Style="{StaticResource FormValorCalculadoStyle}" />
      </StackPanel>
    </Grid>

    <controls:FormField Etiqueta="Observaciones">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
               VerticalContentAlignment="Top"
               Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <!-- PROVISIONAL: constancia manual, no hay Cuentas por Cobrar todavía (ver CLAUDE.md). -->
    <TextBlock Text="Facturación a Dusa (opcional)" Style="{StaticResource CardTitleStyle}" Margin="0,20,0,8" />
    <TextBlock Text="Solo para dejar constancia de que el servicio ya se facturó por fuera de la aplicación; no genera ninguna cuenta por cobrar."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap" Margin="0,0,0,8"
               Foreground="{DynamicResource TextMutedBrush}" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Referencia de la factura">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding FacturaDusaReferencia, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Fecha de la factura">
          <DatePicker Style="{StaticResource FormDatePickerStyle}"
                      SelectedDate="{Binding FacturaDusaFecha}" />
        </controls:FormField>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
