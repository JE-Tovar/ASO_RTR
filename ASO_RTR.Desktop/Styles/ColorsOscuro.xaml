<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta oscura de ASO RTR.

         Se superpone a Colors.xaml en tiempo de ejecucion: Services/Tema.cs la agrega al final
         de Application.Resources.MergedDictionaries, que es lo ultimo que se consulta al buscar
         una clave, asi que gana sobre la clara. Quitarla devuelve el tema claro.

         Por eso NO mergea Colors.xaml y define las claves completas —43 brushes y el efecto de
         sombra—: una que faltara se resolveria contra la paleta clara y saldria un recuadro
         claro sobre fondo oscuro. Al agregar una clave a Colors.xaml hay que agregarla TAMBIEN
         aqui, siempre.

         Los colores van escritos aqui, no derivados de los claros: no hay formula que convierta
         una paleta clara en una oscura decente. Los acentos (exito, aviso, peligro) se aclaran
         un escalon, porque el mismo tono que resalta sobre blanco se apaga sobre un fondo oscuro.

         Comparte tono con la paleta clara —el acento azul-teal provisional, ver Colors.xaml—
         para que la aplicacion tenga una sola identidad y no dos segun el tema. Las superficies
         son un carbon azul-gris, conservando la MISMA escalera de luminancia que Software ASO
         tenia con su verde; los acentos siguen el criterio de arriba y se aclaran. -->

    <SolidColorBrush x:Key="BackgroundBrush" Color="#0F1315" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1B2123" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#111417" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#263036" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#6FC3DE" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#9AE4EF" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#9AE4EF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E0E6E7" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#96A0A3" />
    <!-- Relevo desazulado del gris de ayuda: 7,63:1 sobre el fondo (#0F1315) y 6,75:1 sobre la
         superficie (#1B2123), AA en los dos, mismo margen que tenia Software ASO. -->
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9DA5A9" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2F3A3D" />
    <!-- El escalon fuerte de borde (cabecera de tabla, tarjeta senalada). Aqui ACLARA en vez de
         oscurecer, que es como se separa una superficie sobre fondo oscuro. -->
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#425058" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="InfoBrush" Color="#6FC3DE" />

    <!-- Navegacion lateral: el hover sigue siendo neutro y el seleccionado con el acento, para
         que no se confundan entre si, igual que en la paleta clara. -->
    <SolidColorBrush x:Key="NavHoverBrush" Color="#181F23" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1A3037" />
    <SolidColorBrush x:Key="NavPressedBrush" Color="#224046" />
    <SolidColorBrush x:Key="NavIndicatorBrush" Color="#9AE4EF" />
    <SolidColorBrush x:Key="NavTextSecondaryBrush" Color="#C7D0D3" />

    <SolidColorBrush x:Key="CardHoverBrush" Color="#20292D" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#F87171" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#FCA5A5" />
    <SolidColorBrush x:Key="ToggleHoverBrush" Color="#212A2D" />
    <SolidColorBrush x:Key="FilaAlternaBrush" Color="#161C1E" />

    <!-- Sobre fondo oscuro el velo del hover aclara, en vez de oscurecer como en el tema claro. -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#33FFFFFF" />

    <!-- Fondo suave del boton "Volver al modulo": tiene que dejar leer el acento. -->
    <SolidColorBrush x:Key="VolverFondoBrush" Color="#142A2E" />

    <!-- Pares suave/texto de los estados. Aqui el "suave" es un tinte oscuro del tono, no un
         pastel: sobre fondo oscuro un pastel claro seria una mancha mas brillante que el propio
         dato. El texto va claro y saturado, y es el que lleva el contraste. -->
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#14321F" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#3A2A10" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FCD34D" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3B1A1A" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FCA5A5" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#122A32" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="#9AE4EF" />
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#1B2123" />
    <SolidColorBrush x:Key="NeutralTextBrush" Color="#C7D0D3" />


    <!-- Contorno de los chips: el MISMO tono del texto pero al 35 %.

         A pleno, el borde de un chip de 10 px pesa tanto como su letra, y una tabla con una
         pastilla por fila se convertia en una reja de contornos de colores compitiendo con los
         datos. Al 35 % el contorno sigue cerrando la forma y deja de gritar. El alfa va en el
         color (#59…) porque se compone sobre el fondo tenido del propio chip. -->
    <SolidColorBrush x:Key="SuccessBordeBrush" Color="#594ADE80" />
    <SolidColorBrush x:Key="WarningBordeBrush" Color="#59FCD34D" />
    <SolidColorBrush x:Key="DangerBordeBrush" Color="#59FCA5A5" />
    <SolidColorBrush x:Key="InfoBordeBrush" Color="#599AE4EF" />
    <SolidColorBrush x:Key="NeutralBordeBrush" Color="#59C7D0D3" />

    <!-- Mas oscuros que PrimaryBrush/DangerBrush: el texto blanco de encima aguanta AA, donde
         con los tonos claros de la paleta general desapareceria. -->
    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#25697E" />
    <SolidColorBrush x:Key="DangerButtonBrush" Color="#B91C1C" />

    <!-- Lo que se pinta ENCIMA de un relleno de acento (ver Colors.xaml). Aqui es casi negro y no
         blanco, porque en esta paleta los acentos son los tonos CLAROS: el glifo del punto de la
         linea de tiempo sobre #6FC3DE necesita texto oscuro encima, igual que antes con el verde
         claro. -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0F1315" />

    <SolidColorBrush x:Key="FocusRingBrush" Color="#9AE4EF" />


    <!-- Mas opaca que en claro (60 % contra 25 %): sobre un fondo ya oscuro una sombra tenue no
         se ve, y lo que despega el desplegable del fondo es que la sombra sea claramente mas
         oscura que la superficie de debajo. -->
    <DropShadowEffect x:Key="SombraFlotante" Color="#000000" Opacity="0.6"
                      BlurRadius="16" ShadowDepth="4" Direction="270" />

</ResourceDictionary>
