<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ASO_RTR.Desktop</RootNamespace>
    <AssemblyName>ASO_RTR.Desktop</AssemblyName>
    <Version>1.1.0</Version>
    <ApplicationTitle>ASO RTR</ApplicationTitle>
    <Product>ASO RTR</Product>
    <Company>ASO RTR</Company>
    <Description>Sistema de gestion de control de calidad, limpieza, empacado y etiquetado de botellas</Description>
    <ApplicationIcon>Assets\Logo\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.28" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.28">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
  </ItemGroup>

  <!-- La fuente de iconos viaja con el proyecto. Antes se usaba Segoe MDL2 Assets, que solo
       existe en Windows 10/11 y no se puede fijar a una version. -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\Phosphor.ttf" />
  </ItemGroup>

  <!-- Tipografia de la aplicacion (Satoshi, empotrada igual que Phosphor): asi no depende de que
       este instalada en la maquina. Los tres cortes comparten nombre de familia, asi que WPF
       elige el que toca por FontWeight y AppFont sigue siendo una sola clave. -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\Satoshi-Regular.ttf" />
    <Resource Include="Assets\Fonts\Satoshi-Medium.ttf" />
    <Resource Include="Assets\Fonts\Satoshi-Bold.ttf" />
  </ItemGroup>

  <!-- Logo de marca, recortado de docs/RTR_icon_only.svg (que traia un renglon de texto cortado
       pegado al borde inferior). Se distribuye ya rasterizado (no hay lector de SVG en el
       proyecto): logo-256.png es el logo completo a color (globo + flechas + "RTR"), usado donde
       hay espacio (sidebar, login) — por debajo de ~64px se ve borroso por la rejilla fina del
       globo. logo.ico es un recorte aparte de solo el globo y las flechas, sin las letras "RTR"
       (ilegibles a 16-32px) y sin fondo solido (el naranja de la flecha ya da contraste en tema
       claro y oscuro). logo.ico va tambien como Resource (no solo como ApplicationIcon) para
       poder referenciarlo por pack URI desde el Icon= de cada Window — eso es lo que Windows usa
       de verdad en la barra de tareas/Alt+Tab/Administrador de tareas, no el icono del .exe. -->
  <ItemGroup>
    <Resource Include="Assets\Logo\logo-256.png" />
    <Resource Include="Assets\Logo\logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
